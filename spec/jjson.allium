-- allium: 3
-- jjson.allium
-- Scope: The public jjson encoding and decoding boundary for Jolt programs.
-- Includes: JSON value mapping, numeric fidelity, duplicate keys, pretty output,
--           UTF-8 input validation, optional parsed-key transformation, nesting
--           limits, concurrency safety, packaged execution, and public errors.
-- Excludes: Allocation strategy, performance targets, and intermediate layouts.

contract JsonCodec {
    from_json: (input: Any) -> Any
    from_json_with_options: (input: Any, options: Map<String, Any>) -> Any
    to_json: (value: Any) -> String
    to_json_with_options: (value: Any, options: Map<String, Any>) -> String
    to_json_bytes: (value: Any) -> Any
    to_json_bytes_with_options: (value: Any, options: Map<String, Any>) -> Any

    @invariant AcceptedInput
        -- from_json accepts a JSON string or a byte array containing UTF-8 JSON.
        -- Every other input type fails with a jjson error. Malformed UTF-8 always
        -- fails, independent of permissive settings in the underlying parser.
    @invariant ParsedValues
        -- Objects become maps with string keys, arrays become vectors, JSON null
        -- becomes nil, booleans and strings retain their values, integer tokens
        -- retain their exact values throughout the signed and unsigned 64-bit
        -- ranges, and other number tokens become doubles.
        -- With bigints = true, every integer token retains its exact value,
        -- including values outside the 64-bit ranges. With bigdecimals = true,
        -- decimal and exponent tokens become exact decimals without an
        -- intermediate double conversion. Both options default to false.

    @invariant DuplicateObjectKeys
        -- By default, when an object contains a key more than once, its last
        -- value wins. With reject_duplicate_keys = true, repeated decoded raw
        -- names and collisions after key_fn fail. Checks are object-local.
    @invariant ParsedKeyTransformation
        -- from_json_with_options applies options.key_fn to every object key.
        -- Without key_fn, keys remain strings. If transformed keys collide, the
        -- last value wins unless reject_duplicate_keys is true. Invalid options
        -- and key functions fail. Boolean options require true or false.


    @invariant EncodingValues
        -- Maps become objects; vectors, sequential values, and sets become arrays;
        -- nil becomes null; booleans, strings, and finite numbers retain their
        -- values; symbols and characters become strings.

    @invariant EncodingKeys
        -- String keys are unchanged, keyword keys become name or namespace/name,
        -- and every other map key uses its string representation.

    @invariant ExactWrittenDecimals
        -- Bignums and decimal values are emitted from their exact decimal digits.
        -- Ratios are emitted as doubles.

    @invariant PrettyOption
        -- to_json_with_options produces pretty output exactly when options.pretty
        -- is true; otherwise it produces compact output equivalent to to_json.

    @invariant ByteOutput
        -- to_json_bytes returns a UTF-8 byte array containing the same JSON as
        -- to_json, without a byte-order mark or trailing NUL. Its only option
        -- is pretty, with the same semantics. No input byte array is modified.

    @invariant RejectedValues
        -- NaN, positive or negative infinity, and unsupported values fail rather
        -- than producing invalid or misleading JSON.

    @invariant DepthLimit
        -- Inputs nested to depth 1000 are accepted. Inputs nested deeper than
        -- 1000 fail without overflowing the native stack.

    @invariant ConcurrentIsolation
        -- Concurrent parsing and writing operations do not share mutable request
        -- state or corrupt results. Neither decoding nor encoding prevents
        -- garbage collection: other threads can collect and keep allocating
        -- while an operation of any size is in progress, and every call
        -- terminates without deadlock.

    @invariant PackagedExecution
        -- A standalone application built with jolt build can use from_json and
        -- to_json and to_json_bytes without depending on its working directory
        -- or a native sidecar.
    @invariant ErrorClassification
        -- Every public failure is ex-info whose data contains
        -- type = jjson/error.
        -- Native read errors additionally expose an integer code. Syntax and
        -- malformed-UTF-8 errors expose a zero-based byte_offset and one-based
        -- line and column in the original source; columns count UTF-8 bytes.
        -- CRLF is one newline. Non-source failures need not expose locations.
        -- Duplicate errors expose reason = duplicate-key, the offending key,
        -- and whether the collision happened after transformation.
}
